# {{ ansible_managed }}
tunnel: {{ cloudflare_tunnel_id }}
credentials-file: /etc/cloudflared/{{ cloudflare_tunnel_id }}.json

# Métricas locais para o diag.yml consultar sem depender da API da Cloudflare.
metrics: 127.0.0.1:20241

ingress:
{% for route in cloudflare_ingress %}
  - hostname: {{ route.hostname }}
    service: {{ route.service }}
{% endfor %}
  # Regra final obrigatória: tudo que não casou acima recebe 404.
  - service: http_status:404
