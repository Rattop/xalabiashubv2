# {{ ansible_managed }}
server {
    listen 80;
    server_name {{ base_domain }} www.{{ base_domain }};

    root {{ site_dest }}/public;
    index index.html;

{% for cf_range in cloudflare_ipv4_ranges %}
    set_real_ip_from {{ cf_range }};
{% endfor %}
    real_ip_header CF-Connecting-IP;

    location / {
        try_files $uri $uri/ =404;
    }

    # O diretório old/ contém uma versão anterior do site (22 KB de HTML)
    # que continua servível pela web. Bloqueado.
    location ^~ /old/ {
        deny all;
    }
}
