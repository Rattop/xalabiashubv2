# {{ ansible_managed }}
#
# Único server block para painel.{{ base_domain }}. O antigo painel.conf,
# que declarava o mesmo server_name e causava "conflicting server name" a
# cada start do nginx, foi removido pelo playbook.
server {
    listen 80;
    server_name painel.{{ base_domain }};

    # Sem isto todo log de acesso e todo rate-limit do painel enxerga o IP
    # do Cloudflare em vez do IP real do usuário.
{% for cf_range in cloudflare_ipv4_ranges %}
    set_real_ip_from {{ cf_range }};
{% endfor %}
    real_ip_header CF-Connecting-IP;

    client_max_body_size 100M;

    location / {
        proxy_pass http://127.0.0.1:8081;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        # $scheme, não "https" fixo: o painel.conf antigo mentia o esquema
        # para a aplicação, quebrando geração de URL em acesso interno.
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_redirect          off;
        proxy_buffering         off;
        proxy_request_buffering off;

        # WebSocket: sem isto o console do servidor de jogo não abre.
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }
}
