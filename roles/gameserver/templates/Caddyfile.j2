# {{ ansible_managed }}
:80 {
    root * /var/www/html/public
    encode zstd gzip
    file_server

    php_fastcgi 127.0.0.1:9000 {
        root /var/www/html/public
        index index.php
    }

    try_files {path} {path}/ /index.php?{query}

    log {
        output stdout
        format console
    }
}
